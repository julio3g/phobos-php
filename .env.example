# Copie para .env e ajuste. NUNCA versione o .env.
APP_DEBUG=false
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=phobos_php
DB_USER=postgres
DB_PASSWORD=
# disable | prefer | require (use require em bancos gerenciados: Neon, Supabase)
DB_SSLMODE=prefer
APP_PORT=8080
SEED=false
# Usuário inicial criado por "php bin/seed.php" (dados de desenvolvimento)
SEED_ADMIN_EMAIL=admin@phobos.local
SEED_ADMIN_PASSWORD=troque-esta-senha
